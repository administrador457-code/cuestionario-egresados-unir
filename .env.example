# Base de datos PROPIA del cuestionario (nueva, vacía). La app crea sus tablas al arrancar.
DATABASE_URL=postgresql://usuario:clave@host:puerto/base

# SOLO para el script de sincronización (servicio cron). No la pongas en el servicio web.
# Base de la plataforma de pertinencia: se abre en modo solo lectura.
PROGRAMAS_DATABASE_URL=postgresql://usuario:clave@host:puerto/base

# Opcional: orígenes permitidos si el frontend se publica en otro dominio (separados por coma)
CORS_ORIGINS=
